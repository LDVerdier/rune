{
  "permissions": {
    "allow": [
      "Bash(export PATH=\"$HOME/.volta/bin:$PATH\")",
      "Bash(export PATH=\"/usr/local/bin:/usr/bin:/bin:$HOME/.volta/bin:$PATH\")",
      "Bash(export PATH=\"/usr/local/bin:/opt/homebrew/bin:$PATH\")",
      "Bash(node -e \"const { Accordion } = require\\(''@heroui/react''\\); console.log\\(typeof Accordion\\);\")"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd /Users/laurent/Documents/perso/rune && npx eslint --fix --no-warn-ignored \"$CLAUDE_FILE_PATH\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"$CLAUDE_FILE_PATH\" | grep -qE '\\.(env|pem|key|secret)' && echo 'BLOCKED: Cannot edit secrets/credentials files' && exit 1 || exit 0"
          }
        ]
      }
    ]
  }
}
